@startuml
scale 3
skinparam dpi 300
title Swimlane Diagram Tổng Quát Quy Trình Sáng Tác Và Xuất Bản Manga

|Mangaka|
start

:Tạo hồ sơ Series mới;
:Nộp bản thảo sơ bộ;

|Editorial Board|
:Xem thông tin Series;
:Đánh giá ý tưởng Series;
:Thành viên Hội đồng bỏ phiếu (Đồng ý/Từ chối);

if (Tỷ lệ tán thành >= 50%?) then (Có)

:Quyết định phê duyệt, chọn lịch phát hành & gán Editor;

|Mangaka|
:Tạo Chapter mới;
:Upload các trang Manga;
:Phân vùng công việc;
:Phân công Task cho Assistant;

|Assistant|
:Xem danh sách Task;
:Tải tài nguyên làm việc;
:Thực hiện công việc được giao;
:Nộp Submission cho Task;

|Mangaka|
:Kiểm duyệt Submission của Assistant;

while (Submission đạt yêu cầu?) is (Không)

:Gửi yêu cầu chỉnh sửa;

|Assistant|
:Chỉnh sửa công việc;
:Nộp lại Submission cho Task;

|Mangaka|
:Kiểm duyệt lại Submission;

endwhile (Có)

:Chấp nhận kết quả vẽ;
:Hoàn tất các Task của Chapter;
:Nộp bản thảo Chapter hoàn chỉnh (Trạng thái: Reviewing);

|Tantou Editor|
:Nhận bản thảo Chapter;
:Review nội dung và hình ảnh;

if (Bản thảo đạt yêu cầu?) then (Không)

:Từ chối bản thảo (Rejected);

|Mangaka|
:Nhận phản hồi từ Editor;
:Chương tự động quay về trạng thái Drawing;
:Chỉnh sửa nội dung / phân công lại trợ lý;
:Nộp lại bản thảo Chapter (Trạng thái: Reviewing);

else (Có)

|Tantou Editor|
:Phê duyệt bản thảo Chapter (Approved);
:Phát hành Manga ra công chúng (Published);

endif

|Editorial Board|
:Nhập dữ liệu bình chọn từ độc giả sau mỗi kỳ phát hành;
:Cập nhật bảng xếp hạng các Series;
:Đánh giá hiệu quả hoạt động của Series;

if (Series xếp hạng kém / Có nguy cơ bị hủy?) then (Có)
  if (Quyết định dừng hẳn dự án?) then (Có)
    :Ngừng phát hành Series (Canceled);
  else (Không)
    :Tạm ngưng phát hành Series (Suspended);
  endif
else (Không)
  :Tiếp tục phát hành Series (Ongoing);
endif

stop

else (Không)

:Từ chối đề xuất Series;
stop

endif

@enduml