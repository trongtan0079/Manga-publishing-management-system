@startuml
title Activity Diagram - Quy Trình Review Chapter

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam activityDiamondOrientation vertical

start

partition Mangaka {
  :Hoàn thành Chapter;
  if (Series đã được phê duyệt (Ongoing)?) then (Có)
    :Nộp bản thảo Chapter (Reviewing);
  else (Không)
    :Hệ thống chặn nộp bản thảo\n[Yêu cầu phê duyệt bộ truyện trước];
    detach
  endif
}

partition TantouEditor {
  :Tiếp nhận bản thảo Chapter;
  :Kiểm tra nội dung Chapter;
  :Kiểm tra chất lượng vẽ (Artwork);
}

if (Phát hiện lỗi?) then (Có)
  partition TantouEditor {
    :Ghi chú trực tiếp trên trang vẽ;
    :Từ chối bản thảo (Rejected);
    :Chương tự động chuyển về trạng thái Drawing;
  }
  partition Mangaka {
    :Nhận phản hồi yêu cầu sửa lỗi;
    :Chỉnh sửa nội dung / phân công trợ lý;
    :Nộp lại bản thảo Chapter (Reviewing);
  }
  partition TantouEditor {
    :Review lại Chapter;
  }
endif

partition TantouEditor {
  :Đánh giá tổng thể bản thảo;
}

if (Chương được phê duyệt?) then (Có)
  partition TantouEditor {
    :Phê duyệt bản thảo Chapter (Approved);
    :Cập nhật trạng thái Chapter;
    :Phát hành chương truyện ra công chúng (Published);
  }
  stop
else (Không)
  partition TantouEditor {
    :Từ chối hẳn hoặc gửi phản hồi chỉnh sửa bổ sung;
  }
  stop
endif

@enduml
