@startuml

title Manga Creation and Publishing Management System

skinparam classAttributeIconSize 0

class Role {
  +roleId : int
  +roleName : string
  +description : string
}

class User {
  +userId : int
  +username : string
  +fullName : string
  +email : string
  +passwordHash : string
  +status : string
}

class Series {
  +seriesId : int
  +title : string
  +description : string
  +status : string
  +coverImage : string
}

class Chapter {
  +chapterId : int
  +chapterNumber : int
  +title : string
  +status : string
  +publishedAt : datetime
}

class Page {
  +pageId : int
  +pageNumber : int
  +imageUrl : string
  +status : string
}

class Task {
  +taskId : int
  +title : string
  +description : string
  +priority : string
  +status : string
  +dueDate : datetime
}

class Submission {
  +submissionId : int
  +fileUrl : string
  +notes : string
  +status : string
  +submittedAt : datetime
}

class Review {
  +reviewId : int
  +comments : string
  +rating : int
  +createdAt : datetime
}

class SeriesRanking {
  +rankingId : int
  +rankPosition : int
  +score : decimal
  +periodStartDate : date
}

class Notification {
  +notificationId : int
  +type : string
  +message : string
  +isRead : boolean
}

Role "1" -- "*" User : assigned

User "1" -- "*" Series : creates

Series "1" -- "*" Chapter : contains

Chapter "1" -- "*" Page : contains

Chapter "1" -- "*" Task : requires

User "1" -- "*" Task : assigns
User "1" -- "*" Task : receives

Task "1" -- "*" Submission : generates

Chapter "1" -- "*" Submission : submitted

User "1" -- "*" Submission : submits

Submission "1" -- "*" Review : receives

User "1" -- "*" Review : writes

Series "1" -- "*" SeriesRanking : ranked

User "1" -- "*" SeriesRanking : evaluates

User "1" -- "*" Notification : receives

@enduml
