@startuml

title Manga Creation and Publishing Management System

skinparam classAttributeIconSize 0

class Role {
  +roleId : int
  +roleName : string
  +description : string
}

class User {
  +userId : int
  +username : string
  +fullName : string
  +email : string
  +passwordHash : string
  +status : string
}

class Series {
  +seriesId : int
  +title : string
  +description : string
  +status : string
  +publishType : string
  +coverImage : string
  +editorId : int
}

class Chapter {
  +chapterId : int
  +chapterNumber : int
  +title : string
  +status : string
  +dueDate : datetime
  +publishedAt : datetime
  +isFinal : tinyint
}

class Page {
  +pageId : int
  +pageNumber : int
  +imageUrl : string
  +status : string
}

class PageRegion {
  +regionId : int
  +regionType : string
  +x : int
  +y : int
  +width : int
  +height : int
  +status : string
}

class Task {
  +taskId : int
  +title : string
  +taskType : string
  +description : string
  +resourceUrl : string
  +priority : string
  +status : string
  +dueDate : datetime
}

class Submission {
  +submissionId : int
  +fileUrl : string
  +notes : string
  +status : string
  +submittedAt : datetime
}

class Review {
  +reviewId : int
  +comments : string
  +rating : int
  +createdAt : datetime
}

class SeriesRanking {
  +rankingId : int
  +rankPosition : int
  +score : decimal
  +periodStartDate : date
}

class Notification {
  +notificationId : int
  +type : string
  +message : string
  +isRead : boolean
}

class SystemLog {
  +logId : int
  +action : string
  +details : string
  +ipAddress : string
}

Role "1" -- "*" User : assigned

User "1" -- "*" Series : creates
User "1" -- "*" Series : manages

Series "1" -- "*" Chapter : contains

Chapter "1" -- "*" Page : contains

Page "1" -- "*" PageRegion : segment
Page "1" -- "*" Task : requires
PageRegion "1" -- "*" Task : targetedAt

User "1" -- "*" Task : manager_assigns
User "1" -- "*" Task : assistant_receives

Task "1" -- "*" Submission : generates

Chapter "1" -- "*" Submission : submitted

User "1" -- "*" Submission : submits

Submission "1" -- "*" Review : receives

User "1" -- "*" Review : writes

Series "1" -- "*" SeriesRanking : ranked

User "1" -- "*" SeriesRanking : evaluates

User "1" -- "*" Notification : receives
User "1" -- "*" SystemLog : triggers

@enduml
