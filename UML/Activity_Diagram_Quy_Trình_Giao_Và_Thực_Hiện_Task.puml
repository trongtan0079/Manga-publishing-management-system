@startuml
title Activity Diagram - Quy Trình Giao Và Thực Hiện Task

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam activityDiamondOrientation vertical

start

partition Mangaka {
  :Tạo Task;
  :Phân vùng công việc trên Manga Page (PageRegions);
  :Phân công Task cho Assistant (Trạng thái: pending);
}

if (Trạng thái Chapter là "drawing"?) then (Không (đang là "drafting"))
  :Task ở chế độ ẩn (Gated);\n[Chờ kịch bản/storyboard được Editor duyệt];
  detach
else (Có)
  partition Assistant {
    :Nhận thông báo công việc mới;
    :Xem Task hiển thị trên Dashboard;
    :Tải tài nguyên hỗ trợ vẽ;
    :Thực hiện Artwork (vẽ nền, tô bóng, sfx);
    :Nộp sản phẩm vẽ (Upload Submission);
  }
endif

partition Mangaka {
  :Kiểm duyệt Submission;
}

if (Submission đạt yêu cầu?) then (Có)
  partition Mangaka {
    :Cập nhật trạng thái Task = Completed;
    :Cập nhật tiến độ Chapter;
  }
  stop
else (Không)
  partition Mangaka {
    :Gửi yêu cầu chỉnh sửa;
  }
  partition Assistant {
    :Chỉnh sửa Artwork theo ghi chú;
    :Nộp lại bài vẽ (Upload lại Submission);
  }
  partition Mangaka {
    :Kiểm duyệt lại Submission;
  }

  if (Submission đạt yêu cầu?) then (Có)
    partition Mangaka {
      :Cập nhật trạng thái Task = Completed;
      :Cập nhật tiến độ Chapter;
    }
    stop
  else (Không)
    partition Mangaka {
      :Chuyển Task về trạng thái Rejected (Yêu cầu vẽ lại);
    }
    stop
  endif
endif

@enduml
