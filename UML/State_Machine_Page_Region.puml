@startuml
title State Machine Diagram - Vòng Đời Trạng Thái Của Phân Vùng (Page Region)

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho

[*] --> pending : Mangaka vẽ thủ công phân vùng mới

state pending {
    description : Vùng vừa được tạo, chưa giao việc
}

state in_progress {
    description : Đã giao Task cho Assistant và đang vẽ
}

state completed {
    description : Task trên phân vùng này đã được Mangaka phê duyệt (Approved)
}

pending --> in_progress : Mangaka tạo và giao Task mới gắn với vùng
in_progress --> pending : Mangaka từ chối bản thảo của Trợ lý (Reject)
in_progress --> completed : Mangaka phê duyệt bản thảo (Approve Submission) của Trợ lý
completed --> [*]

@enduml
